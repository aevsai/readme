---
const today = new Date();
---

<footer>
	<div class="rule"></div>
	<p class="meta">
		<span>&copy; {today.getFullYear()} Artem Evsikov</span>
		<span class="sep" aria-hidden="true">·</span>
		<a href="/rss.xml">RSS</a>
		<span class="sep" aria-hidden="true">·</span>
		<button type="button" class="manage-cookies" data-cc="show-preferencesModal">Cookies</button>
	</p>
</footer>

<style>
	footer {
		max-width: var(--measure);
		margin: 5rem auto 0;
		padding: 0 1.5rem 3rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	.rule {
		border-top: 1px dashed var(--ink-faint);
		margin-bottom: 1.25rem;
	}
	.meta {
		margin: 0;
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
	}
	.meta a { color: inherit; }
	.sep { color: var(--ink-faint); }
	.manage-cookies {
		background: none;
		border: none;
		padding: 0;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}
	.manage-cookies:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (max-width: 640px) {
		footer { margin-top: 3rem; padding: 0 1.25rem 2.5rem; }
	}
</style>
