---
import { SOCIAL_LINKS } from '../consts';
---

<header>
	<nav class="socials" aria-label="Social links">
		{SOCIAL_LINKS.map((l, i) => (
			<>
				{i > 0 && <span class="sep" aria-hidden="true">·</span>}
				<a href={l.href} target="_blank" rel="noopener">{l.label}</a>
			</>
		))}
		<span class="sep" aria-hidden="true">·</span>
		<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
			<svg class="t-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"/>
				<path d="M12 2v2"/><path d="M12 20v2"/>
				<path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
				<path d="M2 12h2"/><path d="M20 12h2"/>
				<path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
			</svg>
			<svg class="t-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
			</svg>
		</button>
	</nav>
</header>

<style>
	header {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2.25rem 1.5rem 0;
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0 0.6rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	.socials a {
		text-decoration: none;
		color: var(--ink-deep);
	}
	.socials a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.sep {
		color: var(--ink-faint);
	}
	.theme-toggle {
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--ink-deep);
		line-height: 0;
	}
	.theme-toggle:hover {
		opacity: 0.7;
	}
	.t-sun { display: none; }
	.t-moon { display: block; }
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .t-sun { display: block; }
		:root:not([data-theme="light"]) .t-moon { display: none; }
	}
	:root[data-theme="dark"] .t-sun { display: block; }
	:root[data-theme="dark"] .t-moon { display: none; }
	@media (max-width: 640px) {
		header { padding: 1.5rem 1.25rem 0; }
	}
</style>

<script>
	const btn = document.querySelector('[data-theme-toggle]');
	btn?.addEventListener('click', () => {
		const explicit = document.documentElement.dataset.theme;
		const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
		const isDark = explicit ? explicit === 'dark' : systemDark;
		const next = isDark ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try { localStorage.setItem('theme', next); } catch {}
	});
</script>
